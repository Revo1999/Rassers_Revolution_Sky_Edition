          "count": 1,
          "consume_items": false
        }
      ],
      "rewards": []
    },
    {
      "id": "5E40000000000009",
      "title": "Commission the Water-Cooled Drill",
      "icon": {
        "id": "revoextraction:steel_drill_controller",
        "count": 1
      },
      "x": 12.0,
